# Database runtime connection (transaction pooler is suitable for serverless requests)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Database migration connection (direct connection or session pooler on port 5432)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
# Used only when Clerk does not receive a safe redirect_url from the request.
# /onboarding enforces auth and sends already-completed users to /app.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/onboarding"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/onboarding"

# Canonical public application URL
NEXTAUTH_URL="http://localhost:3000"

# Stripe billing and webhook verification
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_BETA="price_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_AGENCY="price_..."
# Explicit launch switches. Both payment surfaces default off.
# Product launch gate; must agree with the service gate below.
ENABLE_BETA_CHECKOUT="false"
SUBSCRIPTION_CHECKOUT_ENABLED="false"
# Keep false until refund/dispute credit reversals are implemented and tested.
POTION_CHECKOUT_ENABLED="false"
# Set explicitly in production. Defaults to true only when NODE_ENV=production.
STRIPE_LIVEMODE="false"

# Vercel Cron authorization. Generate a long random value; never commit the real one.
CRON_SECRET="replace-with-at-least-32-random-bytes"
# Forward-only cutover switch. Leave false until backup, migration, and preview
# worker verification gates pass.
ENABLE_SCAN_WORKER="false"
DURABLE_WORKER_ENABLED="false"

# Operational and account-lifecycle endpoints. Leave blank until Phase 5
# runbook secrets are provisioned in the deployment environment.
OPS_SECRET="replace-with-a-different-32-byte-random-secret"
CLERK_WEBHOOK_SIGNING_SECRET=""
DELETION_AUDIT_SECRET=""
# Dedicated destructive lifecycle switch. Keep false until the signed Clerk
# webhook and deletion worker have passed the Phase 5 production runbook.
ACCOUNT_DELETION_ENABLED="false"

# Optional provider integrations
TWITTER_BEARER_TOKEN=""
OPENAI_API_KEY=""
OPENAI_REPLY_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""
GOOGLE_AI_API_KEY=""
# Distributed economic control for AI replies. All three are required; AI
# fails closed when the limiter cannot be reached.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
RATE_LIMIT_KEY_SECRET="replace-with-a-third-32-byte-random-secret"
LOG_LEVEL="info"

# Internal publishing is disabled in production unless both are configured.
BLOG_ADMIN_USER_IDS=""
BLOG_PUBLISHING_ENABLED="false"

# Testing integrations
PHASE45_INTEGRATION_TEST="false"
BILLING_INTEGRATION_TEST="false"
