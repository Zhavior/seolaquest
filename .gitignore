# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/hypequest-engine/

# production
/build

# misc
.DS_Store
*.pem

# debug
# Broad on purpose: test.log, next_start.log, and onboarding-debug.log were all
# committed by accident before this line existed.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# clerk configuration (can include secrets)
/.clerk/

# local provider/runtime state
/supabase/.temp/
/prisma/*.db

# macOS/cloud-sync duplicates ("Foo 2.tsx"). These appear in bulk whenever the
# working tree changes under a syncing folder, and one of them previously
# landed in .git/refs and broke fetch. The lint script already skips this same
# pattern; keeping them untracked stops `git add -A` from sweeping them in.
* 2.*
* [0-9].*
