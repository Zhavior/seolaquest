{
  "name": "seolaquest-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint app components lib features src prisma/seed.ts proxy.ts --ignore-pattern '**/* 2.*' --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "dotenv -e .env.local -- cross-env EVENT_CORE_INTEGRATION_TEST=true PHASE45_INTEGRATION_TEST=true BILLING_INTEGRATION_TEST=true vitest run",
    "test:a11y": "bash scripts/phase-5-accessibility-gate.sh",
    "db": "dotenv -e .env.local -- prisma",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:seed": "dotenv -e .env.local -- prisma db seed"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.6.2",
    "@google/genai": "^2.15.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@sentry/nextjs": "^10.69.0",
    "@stripe/stripe-js": "^9.12.1",
    "@supabase/ssr": "^0.12.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "pixi.js": "^8.19.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "twitter-api-v2": "^1.29.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.12",
    "@playwright/test": "^1.62.1",
    "@prisma/client": "5.10.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "axe-core": "^4.12.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.23",
    "prisma": "5.10.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
