generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String            @id @default(uuid())
  email               String            @unique
  name                String?
  profileIconKey      String?
  title               String?
  onboardingComplete  Boolean           @default(false)
  onboardingStep      Int               @default(1)
  businessDescription String?
  targetCustomer      String?
  firstKeyword        String?
  preferredSource     OnboardingSource?
  emailDigest         Boolean           @default(true)
  radarAlerts         Boolean           @default(true)
  crmWebhookUrl       String?
  questsRemaining     Int               @default(0)
  spellsCast          Int               @default(0)
  questsExported      Int               @default(0)
  maxCredits          Int               @default(0)
  xpMultiplier        Float             @default(1.0)
  level               Int               @default(1)
  xp                  Int               @default(0)
  xpRequired          Int               @default(100)
  unlockedTheme       String            @default("PARCHMENT_WOOD")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  keywords               TrackedKeyword[]
  leads                  Lead[]
  posts                  Post[]
  billingSubscription    BillingSubscription?
  checkoutIntents        CheckoutIntent[]
  creditLedger           CreditLedgerEntry[]
  durableJobs            DurableJob[]
  scanSchedule           TenantScanSchedule?
  scanRuns               ScanRun[]
  crmDeliveries          CrmExportDelivery[]
  accountDeletionRequest AccountDeletionRequest?
  auditTrails            AuditTrail[]
  gamifyProfile          GamifyProfile?

  @@index([createdAt])
}

enum OnboardingSource {
  REDDIT
  X
}

model TrackedKeyword {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phrase    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  leads            Lead[]
  providerAttempts ProviderScanAttempt[]
  leadMatches      LeadMatch[]

  @@unique([userId, phrase])
  @@index([userId, active])
}

enum LeadStatus {
  NEW
  VIEWED
  CONTACTED
  DISMISSED
}

model Lead {
  id              String             @id @default(uuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  keywordId       String
  keyword         TrackedKeyword     @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  platform        String
  externalPostId  String
  author          String
  content         String
  matched         String
  url             String
  sourceCreatedAt DateTime?
  observedAt      DateTime           @default(now())
  status          LeadStatus         @default(NEW)
  claimedAt       DateTime?
  contactedAt     DateTime?
  dismissedAt     DateTime?
  crmExportedAt   DateTime?
  createdAt       DateTime           @default(now())
  crmDelivery     CrmExportDelivery?
  matches         LeadMatch[]

  @@unique([userId, externalPostId])
  @@index([userId, status, createdAt])
  @@index([keywordId])
}

model Post {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model BillingSubscription {
  id                         String    @id @default(uuid())
  userId                     String    @unique
  user                       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId           String    @unique
  stripeSubscriptionId       String?   @unique
  stripePriceId              String?
  plan                       String    @default("FREE")
  status                     String    @default("inactive")
  currentPeriodEnd           DateTime?
  cancelAtPeriodEnd          Boolean   @default(false)
  latestStripeEventCreatedAt DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([status])
}

model CheckoutIntent {
  id                      String   @id @default(uuid())
  userId                  String
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind                    String
  sku                     String
  expectedAmount          Int?
  currency                String   @default("usd")
  status                  String   @default("PENDING")
  activeKey               String?  @unique
  stripeCheckoutSessionId String?  @unique
  stripeCheckoutUrl       String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([userId, createdAt])
}

model StripeWebhookEvent {
  id              String    @id @default(uuid())
  eventId         String    @unique
  eventType       String
  objectId        String?
  livemode        Boolean
  stripeCreatedAt DateTime
  status          String    @default("PROCESSING")
  attempts        Int       @default(1)
  error           String?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, createdAt])
  @@map("ProcessedWebhook")
}

model CreditLedgerEntry {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta      Int
  reason     String
  sourceType String
  sourceId   String
  createdAt  DateTime @default(now())

  @@unique([sourceType, sourceId])
  @@index([userId, createdAt])
}

model DurableJob {
  id              String             @id @default(uuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            String
  status          String             @default("PENDING")
  dedupeKey       String             @unique
  scanRunId       String?            @unique
  scanRun         ScanRun?           @relation(fields: [scanRunId], references: [id], onDelete: Cascade)
  crmDeliveryId   String?            @unique
  crmDelivery     CrmExportDelivery? @relation(fields: [crmDeliveryId], references: [id], onDelete: Cascade)
  attempts        Int                @default(0)
  maxAttempts     Int                @default(5)
  nextAttemptAt   DateTime           @default(now())
  leaseOwner      String?
  leaseGeneration Int                @default(0)
  leaseExpiresAt  DateTime?
  lastErrorCode   String?
  completedAt     DateTime?
  deadAt          DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status, nextAttemptAt, createdAt])
  @@index([userId, status, nextAttemptAt])
  @@index([leaseExpiresAt])
}

model TenantScanSchedule {
  userId          String    @id
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled         Boolean   @default(false)
  nextDueAt       DateTime  @default(now())
  lastEnqueuedAt  DateTime?
  lastCompletedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([enabled, nextDueAt, userId])
}

model ScanRun {
  id                String                @id @default(uuid())
  userId            String
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  trigger           String
  windowStartedAt   DateTime
  activeKey         String?               @unique
  status            String                @default("QUEUED")
  providerSucceeded Boolean?
  leadsCreated      Int                   @default(0)
  lastErrorCode     String?
  completedAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  durableJob        DurableJob?
  providerAttempts  ProviderScanAttempt[]
  leadMatches       LeadMatch[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model ProviderScanAttempt {
  id               String          @id @default(uuid())
  scanRunId        String
  scanRun          ScanRun         @relation(fields: [scanRunId], references: [id], onDelete: Cascade)
  keywordId        String?
  keyword          TrackedKeyword? @relation(fields: [keywordId], references: [id], onDelete: SetNull)
  keywordSnapshot  String
  provider         String
  requestedAt      DateTime
  completedAt      DateTime?
  outcome          String          @default("IN_PROGRESS")
  httpStatusClass  Int?
  resultCount      Int             @default(0)
  insertedCount    Int             @default(0)
  rateLimitResetAt DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  leadMatches      LeadMatch[]

  @@unique([scanRunId, provider, keywordSnapshot])
  @@index([scanRunId, provider, outcome])
  @@index([keywordId])
}

model LeadMatch {
  id                    String              @id @default(uuid())
  leadId                String
  lead                  Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  scanRunId             String
  scanRun               ScanRun             @relation(fields: [scanRunId], references: [id], onDelete: Cascade)
  providerScanAttemptId String
  providerScanAttempt   ProviderScanAttempt @relation(fields: [providerScanAttemptId], references: [id], onDelete: Cascade)
  keywordId             String?
  keyword               TrackedKeyword?     @relation(fields: [keywordId], references: [id], onDelete: SetNull)
  keywordSnapshot       String
  matchedAt             DateTime            @default(now())

  @@unique([leadId, providerScanAttemptId])
  @@index([scanRunId, matchedAt])
  @@index([keywordId])
}

model CrmExportDelivery {
  id                     String      @id @default(uuid())
  userId                 String
  user                   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId                 String      @unique
  lead                   Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status                 String      @default("QUEUED")
  payload                Json
  destinationFingerprint String
  responseStatus         Int?
  deliveredAt            DateTime?
  lastErrorCode          String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  durableJob             DurableJob?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model ClerkWebhookEvent {
  id        String   @id @default(uuid())
  eventId   String   @unique
  eventType String
  createdAt DateTime @default(now())
}

model AccountDeletionRequest {
  id                   String    @id @default(uuid())
  subjectDigest        String    @unique
  userId               String?   @unique
  user                 User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  source               String
  status               String    @default("PENDING")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  attempts             Int       @default(0)
  maxAttempts          Int       @default(8)
  availableAt          DateTime  @default(now())
  leaseToken           String?
  leaseExpiresAt       DateTime?
  lastErrorCode        String?
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status, availableAt])
  @@index([leaseExpiresAt])
  @@index([stripeCustomerId])
}

model AccountDeletionAudit {
  id                     String   @id @default(uuid())
  requestId              String   @unique
  subjectDigest          String   @unique
  stripeCustomerDigest   String?  @unique
  source                 String
  resultCode             String
  userRowsDeleted        Int
  keywordRowsDeleted     Int
  leadRowsDeleted        Int
  postRowsDeleted        Int
  checkoutRowsDeleted    Int
  ledgerRowsDeleted      Int
  billingRowsDeleted     Int      @default(0)
  durableJobRowsDeleted  Int      @default(0)
  scanRunRowsDeleted     Int      @default(0)
  crmDeliveryRowsDeleted Int      @default(0)
  completedAt            DateTime
  createdAt              DateTime @default(now())
}

model OperationalHeartbeat {
  id              String    @id
  lastStartedAt   DateTime
  lastSucceededAt DateTime?
  lastErrorCode   String?
  updatedAt       DateTime  @updatedAt
}

model AuditTrail {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  status      String
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
}

model DomainEventLog {
  id             String    @id @default(uuid())
  eventId        String    @unique
  type           String
  version        Int       @default(1)
  actorId        String
  source         String
  correlationId  String
  causationId    String?
  idempotencyKey String    @unique
  payload        Json
  metadata       Json?
  status         String    @default("PENDING") // PENDING, PROCESSING, PROCESSED, FAILED
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  availableAt    DateTime  @default(now())
  lockedAt       DateTime?
  lastErrorCode  String?
  occurredAt     DateTime
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  consumerReceipts DomainEventConsumerReceipt[]

  @@index([status, availableAt, createdAt])
  @@index([status, lockedAt])
  @@index([actorId, type, occurredAt])
  @@index([correlationId])
}

model DomainEventConsumerReceipt {
  id            String         @id @default(uuid())
  eventId       String
  event         DomainEventLog @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
  consumerKey   String
  status        String         @default("PROCESSED") // PROCESSED, FAILED
  attemptCount  Int            @default(1)
  lastError     String?
  processedAt   DateTime?
  lastAttemptAt DateTime       @default(now())
  createdAt     DateTime       @default(now())

  @@unique([eventId, consumerKey])
  @@index([consumerKey, status])
}

model AuroraDecision {
  id                         String   @id @default(uuid())
  opportunityId              String
  sourceEventId              String
  finalScore                 Int
  confidence                 Float
  priority                   String // LOW, MEDIUM, HIGH, CRITICAL
  recommendedAction          String // IGNORE, WATCH, ENGAGE
  deterministicSignals       Json
  semanticSignals            Json?
  reasons                    Json // JSON Array of strings
  policyFlags                Json // JSON Array of strings
  classifierProvider         String?
  classifierModel            String?
  classifierVersion          String
  deterministicScorerVersion String
  policyVersion              String
  semanticFailureCode        String?
  evaluationStatus           String // LIVE, DETERMINISTIC_ONLY, FALLBACK, UNAVAILABLE
  createdAt                  DateTime @default(now())

  feedbacks AuroraFeedback[]

  @@unique([sourceEventId, deterministicScorerVersion, classifierVersion, policyVersion])
  @@index([opportunityId])
  @@index([recommendedAction, priority])
}

model AuroraFeedback {
  id           String         @id @default(uuid())
  decisionId   String
  decision     AuroraDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  feedbackType String // DISMISSED, SAVED, ENGAGED, REPLIED, QUALIFIED, CONVERTED, MANUAL_OVERRIDE
  source       String
  correction   Json?
  createdAt    DateTime       @default(now())

  @@index([decisionId])
  @@index([feedbackType])
}

model GamifyProfile {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lifetimeXp Int      @default(0)
  level      Int      @default(1)
  reputation Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  xpTransactions         GamifyXpTransaction[]
  reputationTransactions GamifyReputationTransaction[]
  questAssignments       GamifyQuestAssignment[]
}

model GamifyXpTransaction {
  id             String               @id @default(uuid())
  actorId        String
  profile        GamifyProfile        @relation(fields: [actorId], references: [userId], onDelete: Cascade)
  sourceEventId  String
  targetKey      String?
  ruleId         String
  ruleVersion    Int
  entryType      String // AWARD, REVERSAL
  amount         Int
  reason         String
  idempotencyKey String               @unique // award:{actorId}:{sourceEventId}:{ruleId}:{ruleVersion} OR reversal:{originalTransactionId}
  reversalOfId   String?              @unique
  reversalOf     GamifyXpTransaction? @relation("XpReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy     GamifyXpTransaction? @relation("XpReversal")
  createdAt      DateTime             @default(now())

  @@index([actorId, createdAt])
  @@index([actorId, ruleId, targetKey])
  @@index([sourceEventId])
}

model GamifyReputationTransaction {
  id             String                       @id @default(uuid())
  actorId        String
  profile        GamifyProfile                @relation(fields: [actorId], references: [userId], onDelete: Cascade)
  sourceEventId  String
  targetKey      String?
  ruleId         String
  ruleVersion    Int
  entryType      String // AWARD, REVERSAL
  amount         Int
  reason         String
  idempotencyKey String                       @unique
  reversalOfId   String?                      @unique
  reversalOf     GamifyReputationTransaction? @relation("ReputationReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy     GamifyReputationTransaction? @relation("ReputationReversal")
  createdAt      DateTime                     @default(now())

  @@index([actorId, createdAt])
  @@index([actorId, ruleId, targetKey])
  @@index([sourceEventId])
}

model GamifyQuest {
  id           String    @id @default(uuid())
  code         String
  version      Int
  title        String
  description  String
  type         String // ONBOARDING, DAILY, WEEKLY, MILESTONE, AURORA
  eventType    String
  eventVersion Int       @default(1)
  target       Int
  rewardXp     Int
  enabled      Boolean   @default(true)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime  @default(now())

  assignments GamifyQuestAssignment[]

  @@unique([code, version])
  @@index([eventType, eventVersion, enabled])
  @@index([enabled, startsAt, endsAt])
}

model GamifyQuestAssignment {
  id          String        @id @default(uuid())
  questId     String
  quest       GamifyQuest   @relation(fields: [questId], references: [id], onDelete: Restrict)
  actorId     String
  profile     GamifyProfile @relation(fields: [actorId], references: [userId], onDelete: Cascade)
  cycleKey    String        @default("once")
  progress    Int           @default(0)
  target      Int
  rewardXp    Int
  status      String        @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, CLAIMED, EXPIRED
  assignedAt  DateTime      @default(now())
  completedAt DateTime?
  claimedAt   DateTime?
  expiresAt   DateTime?

  contributions GamifyQuestContribution[]

  @@unique([actorId, questId, cycleKey])
  @@index([actorId, status, assignedAt])
  @@index([status, expiresAt])
}

model GamifyQuestContribution {
  id                 String                @id @default(uuid())
  assignmentId       String
  assignment         GamifyQuestAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  sourceEventId      String
  sourceEventType    String
  sourceEventVersion Int
  increment          Int                   @default(1)
  occurredAt         DateTime
  createdAt          DateTime              @default(now())

  @@unique([assignmentId, sourceEventId])
  @@index([sourceEventId])
  @@index([assignmentId, createdAt])
}
